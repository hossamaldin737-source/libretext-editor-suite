{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "paths": {
      "@libretext/core": ["./packages/core/src"],
      "@libretext/core/*": ["./packages/core/src/*"],
      "@libretext/algorithms": ["./packages/algorithms/src"],
      "@libretext/algorithms/*": ["./packages/algorithms/src/*"],
      "@libretext/storage": ["./packages/storage/src"],
      "@libretext/storage/*": ["./packages/storage/src/*"],
      "@libretext/templates": ["./packages/templates/src"],
      "@libretext/templates/*": ["./packages/templates/src/*"],
      "@libretext/serializers-basic": ["./packages/serializers/src/basic"],
      "@libretext/serializers-advanced": ["./packages/serializers/src/advanced"],
      "@libretext/adapters": ["./packages/adapters/src"],
      "@libretext/adapters/*": ["./packages/adapters/src/*"],
      "@libretext/plugins": ["./packages/plugins/src"],
      "@libretext/plugins/*": ["./packages/plugins/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
